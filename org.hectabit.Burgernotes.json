{
  "id": "org.hectabit.Burgernotes",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.golang"
  ],
  "command": "burgernotes",
  "finish-args": [
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=ipc",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "Burgernotes",
      "buildsystem": "simple",
      "build-commands": [
        "make install DESTDIR=/app/bin/ SHAREDIR=/app/share/ GO=/usr/lib/sdk/golang/bin/go"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/ailur-archives/burgernotes-app",
          "tag": "1.4",
          "commit": "49182fd220a152fdfd70c0eb37f79560ba1805f5"
        }
      ]
    }
  ]
}
